#!/usr/bin/env bash
# pre-commit —— 提交前代码审查门禁（对应 CLAUDE.md 提交纪律：三件套必过 + AI 审查）
#
# 审查内容（按暂存文件类型按需执行，纯文档提交不空跑）：
#   预检：git diff --cached --check（冲突标记/空白错误，markdown 除外）；暂存 Shell 过 bash -n
#   *.ts / *.tsx / *.js 及影响 Web 构建的配置
#                           → pnpm -r typecheck && pnpm -r test && pnpm -r lint
#   *.sql（DB 迁移）         → 迁移重放校验（apps/web/scripts/verify-migrations.mjs：
#                              全部迁移应用到一次性库 + quick_check——Node 三件套不解析
#                              SQL，对 .sql 提交是零验证的空转）
#   services/ai-engine 的 *.py / pyproject.toml / uv.lock
#                           → uv run --locked pytest（依赖清单走引擎门禁而非 Node 门禁：
#                              uv.lock 未同步只有 --locked 能拦；虚拟环境未就绪时提示跳过）
#   代码文件（TS/JS/Py/Shell/SQL）→ scripts/ai-review.sh --staged AI 语义审查
#     （只审暂存快照：未暂存的 WIP 不入审、审查内容与提交严格一致；
#       简洁性/架构/复用/维护/可读性 + .opencodereview/rule.json 项目规范，
#       critical/high 阻断提交；ocr 缺失或故障时自动降级放行）
#
# 启用方式（hooks 目录随仓库版本化，需一次性指给 git）：
#   git config core.hooksPath .githooks
#
# 跳过方式：
#   git commit --no-verify          # git 原生跳过（紧急情况，慎用）
#   SKIP_GATES=1 git commit ...     # 同上，等价开关
#   SKIP_AI=1 git commit ...        # 仅跳过 AI 审查层（三件套仍执行）
set -euo pipefail

# 钩子可能从子目录被调用，统一回到仓库根执行
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ---- 逃生口：明确声明跳过门禁 ----
if [[ "${SKIP_GATES:-0}" == "1" ]]; then
  echo "[pre-commit] SKIP_GATES=1，跳过代码审查门禁"
  exit 0
fi

# ---- 收集暂存文件（新增/复制/修改/重命名，排除删除）----
# 关闭 core.quotePath：默认开启时含中文/特殊字符的路径会被 C 转义成 "path\344\270\255"
# 形式，结尾多出引号，下方的扩展名匹配全部失配 → 所有门禁被静默跳过
staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)"

if [[ -z "$staged" ]]; then
  echo "[pre-commit] 无暂存文件（如为空提交则直接放行）"
  exit 0
fi

fail_gate() { # $1=失败环节 $2=提示
  printf '\n\033[1;31m[pre-commit] %s 未通过\033[0m\n%s\n' "$1" "$2" >&2
  exit 1
}

# ---- 判断是否涉及 TS/JS 代码或影响其构建的配置（走三件套门禁）----
# 配置类（package.json/lockfile/tsconfig/eslint 配置）单独改动也可能破坏类型/测试，
# 只按代码文件触发会漏掉这类提交。*.sql 不在此列（Node 三件套不解析 SQL，对 .sql
# 提交是零验证的空转），走下方专门的迁移重放门禁；引擎依赖清单（pyproject.toml/
# uv.lock）同理走引擎门禁（--locked 才能拦 lock 未同步）
ts_files="$(grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$|(^|/)(package\.json|pnpm-lock\.yaml|tsconfig[^/]*\.json|eslint\.config\.[^/]+|next\.config\.[^/]+)$' <<<"$staged" || true)"

# ---- 判断是否涉及 DB 迁移 SQL（走迁移重放门禁）----
sql_files="$(grep -E '\.sql$' <<<"$staged" || true)"

# ---- 判断是否涉及引擎 Python 代码或依赖清单（走 pytest + --locked 门禁）----
py_files="$(grep -E '^services/ai-engine/.*\.py$|^services/ai-engine/(pyproject\.toml|uv\.lock)$' <<<"$staged" || true)"

# ---- 判断是否涉及 Shell 脚本（一并纳入 AI 审查范围）----
sh_files="$(grep -E '\.(sh)$|^\.githooks/' <<<"$staged" || true)"

if [[ -z "$ts_files" && -z "$py_files" && -z "$sh_files" && -z "$sql_files" ]]; then
  echo "[pre-commit] 暂存内容不含代码文件，跳过门禁"
  exit 0
fi

# ---- 预检 A：暂存 diff 卫生检查 ----
# git diff --cached --check 拦两类问题：未解决的冲突标记（<<<<<<<）与空白错误
# （行尾空格/缩进混用 tab）；有问题的文件与行号直接打印在失败信息里。
# markdown 显式排除：其硬换行就是行尾双空格、又常保留 CRLF，混排提交（代码+文档）
# 里文档的合法排版会把整个提交硬拦——这只会把人推向 --no-verify
if ! git diff --cached --check -- . ':(exclude)*.md' ':(exclude)*.markdown'; then
  fail_gate "diff 卫生检查" "暂存内容含冲突标记或空白错误：请修复后重新暂存（git diff --cached --check -- . ':(exclude)*.md' 查看详情）"
fi

# ---- 预检 B：暂存 Shell 脚本语法检查 ----
# bash -n 只做语法解析不执行；读暂存版本（git show :file）而非工作区文件——
# 工作区可能是修复后的，与实际提交内容不一致。
# 只查 shebang 声明为 shell 的脚本：.githooks/ 里将来混入非 shell 钩子
# （如 python 的 commit-msg）不该被当 shell 解析而误报语法错误
if [[ -n "$sh_files" ]]; then
  while IFS= read -r f; do
    shebang="$(git show ":$f" | head -n 1)"
    if [[ "$shebang" =~ ^#![[:space:]]*/.*[ab]?sh([[:space:]]|$) ]]; then
      if ! git show ":$f" | bash -n; then
        fail_gate "bash -n" "暂存的 $f 存在 Shell 语法错误：请修复后重新暂存"
      fi
    fi
  done <<<"$sh_files"
fi

# ---- 门禁一/二/三：TS/JS 三件套（typecheck → test → lint，串行短路）----
if [[ -n "$ts_files" ]]; then
  command -v pnpm >/dev/null 2>&1 \
    || fail_gate "pnpm" "未找到 pnpm，请先安装（Node ≥22 / pnpm 10）"

  echo "[pre-commit] 门禁 1/6 typecheck ..."
  pnpm -r typecheck \
    || fail_gate "typecheck" "类型检查失败：请修复后再提交，或 git commit --no-verify 跳过（慎用）"

  echo "[pre-commit] 门禁 2/6 test ..."
  pnpm -r test \
    || fail_gate "test" "单元测试失败：请修复后再提交，或 git commit --no-verify 跳过（慎用）"

  echo "[pre-commit] 门禁 3/6 lint ..."
  pnpm -r lint \
    || fail_gate "lint" "代码风格检查失败：请修复后再提交，或 git commit --no-verify 跳过（慎用）"
fi

# ---- 门禁四：引擎 pytest（工具/虚拟环境未就绪时提示跳过，不误报为测试失败）----
if [[ -n "$py_files" ]]; then
  if [[ ! -d "services/ai-engine/.venv" ]]; then
    echo "[pre-commit] 引擎虚拟环境未初始化，跳过 pytest（首次请运行 ./scripts/engine-setup.sh）"
  elif ! command -v uv >/dev/null 2>&1; then
    echo "[pre-commit] 未安装 uv（.venv 已存在），跳过 pytest——工具缺失不等于测试失败"
  else
    echo "[pre-commit] 门禁 4/6 引擎 pytest ..."
    # --locked：lock 与 pyproject 不一致时直接失败，而非静默改写 lock 继续跑
    (uv run --locked --directory services/ai-engine pytest -q) \
      || fail_gate "pytest" "引擎测试失败：请修复后再提交，或 git commit --no-verify 跳过（慎用）"
  fi
fi

# ---- 门禁五：DB 迁移重放（*.sql 暂存时；一次性库上全量重放 + quick_check）----
# Node 三件套不解析 SQL，此前的 *.sql 触发方式是零验证空转；重放能拦下
# 语法错误、顺序依赖错、与既有 schema 冲突的破坏性 DDL
if [[ -n "$sql_files" ]]; then
  command -v pnpm >/dev/null 2>&1 \
    || fail_gate "pnpm" "未找到 pnpm，请先安装（Node ≥22 / pnpm 10）"
  echo "[pre-commit] 门禁 5/6 DB 迁移重放 ..."
  (pnpm --filter @pinglc/web exec node scripts/verify-migrations.mjs) \
    || fail_gate "迁移重放" "迁移在一次性库上重放失败：请修复迁移文件后再提交（详情见上方输出）"
fi

# ---- 门禁六：AI 语义审查（scripts/ai-review.sh 内部自带降级与 SKIP_AI 逃生口）----
# --staged：只审暂存快照，未暂存的 WIP 不入审（审查内容与提交严格一致）；
# 退出码语义：1=存在阻断级发现（拦下）；2=工具侧前提不满足（如仓库尚无 HEAD 基线）——
# 属「AI 层故障」而非代码问题，按约定降级放行并醒目提示，不把人推向 --no-verify。
# 经 bash 调用并做存在性守卫：脚本缺失或丢失执行位时降级放行，
# 而不是以 126/127 阻断每一次提交（与「AI 层故障绝不卡死提交」的约定一致）
if [[ -f "$ROOT/scripts/ai-review.sh" ]]; then
  echo "[pre-commit] 门禁 6/6 AI 语义审查（ocr，审暂存快照，约 0.5-2 分钟）..."
  ai_rc=0
  bash "$ROOT/scripts/ai-review.sh" --staged || ai_rc=$?
  if [[ "$ai_rc" -eq 2 ]]; then
    echo "[pre-commit] AI 审查工具侧前提不满足（exit 2），降级放行——详见上方输出" >&2
  elif [[ "$ai_rc" -ne 0 ]]; then
    fail_gate "AI 审查" "存在阻断级发现（critical/high）：请修复后重新提交，或 SKIP_AI=1 / git commit --no-verify 跳过（慎用）"
  fi
else
  echo "[pre-commit] scripts/ai-review.sh 缺失，跳过 AI 审查（降级放行）"
fi

echo "[pre-commit] 代码审查门禁全部通过 ✓"
