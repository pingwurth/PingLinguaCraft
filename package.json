{
  "//": "PingLinguaCraft monorepo 根配置：统一管理全工作区的开发脚本与工具链版本",
  "name": "pinglinguacraft",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pinglc/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @pinglc/web db:generate",
    "db:migrate": "pnpm --filter @pinglc/web db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp"]
  }
}
